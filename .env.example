# Monlam Melong — primary LLM for most agents (Studio X-API-Key)
# Same key is used for Melong chat, TTS, STT, and OCR (single/multi-page).
MONLAM_API_KEY=YOUR_MONLAM_X_API_KEY
MONLAM_API_BASE=https://api-v1.monlamai.studio
MONLAM_MODEL=melong

# Anthropic Claude — ONLY for grammar check when key is set (all other agents = Melong)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_API_URL=https://api.anthropic.com/v1/messages
# Grammar check only: auto = Claude if key set else Melong | claude | melong
GRAMMAR_LLM_PROVIDER=auto

# Database (local Homebrew PostgreSQL or Docker Compose)
DATABASE_URL=postgresql+asyncpg://lobsangtashi@localhost:5432/monlam_rignor
DATABASE_URL_SYNC=postgresql://lobsangtashi@localhost:5432/monlam_rignor

# Redis (optional) — shared grammar/RAG caches + rate limits across workers.
# Leave empty to use in-process memory only (fail-open if Redis is down).
# Docker Compose sets REDIS_URL=redis://redis:6379/0 automatically.
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0
REDIS_PREFIX=mr

# JWT — must be ≥32 random chars (required when APP_ENV=production)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
# Access token lifetime (minutes). Refresh tokens last JWT_REFRESH_EXPIRE_DAYS.
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

# local | production
APP_ENV=local
# Honor X-Forwarded-For / X-Real-IP only behind a trusted reverse proxy (nginx).
# Spoofable if enabled without a trusted hop — keep false for local direct access.
TRUST_PROXY_HEADERS=false
# OpenAPI docs (defaults: on for local, off for production)
# ENABLE_DOCS=true

# Email OTP (Mailpit in Docker, or console fallback locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@monlam-rignor.local
OTP_EXPIRE_MINUTES=10
# Never enable in production — prints codes to logs
OTP_DEV_LOG=false

# Embeddings — BGE-M3 (Tibetan-capable), page-wise grammar handbook chunks
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_PRELOAD=true

# Knowledge
GRAMMAR_PDF_PATH=classical-tibetan-grammar-handbook_compress.pdf
# Second grammar ground truth (scanned PDF → Monlam OCR → embed)
GRAMMAR_SECONDARY_PDF_PATH=secon-grammer.pdf
GRAMMAR_OCR_CACHE_PATH=data/grammar_ocr
CONTENT_PATH=data/content

# Optional botok (Tibetan tokenizer) for grammar case spans + RAG particle queries.
# Fail-open to regex when dialect pack is missing. Place pack at BOTOK_BASE_PATH/general
# (or ~/Documents/pybo/dialect_packs/general). See data/botok/README.md.
GRAMMAR_USE_BOTOK=true
BOTOK_BASE_PATH=data/botok
BOTOK_DIALECT_NAME=general

# Grammar check speed (caches; LLM budget)
# Same text+profile hits result cache; RAG hits cached separately.
# With REDIS_URL set, caches are shared (memory remains a fast local L1).
GRAMMAR_RESULT_CACHE_TTL_S=1800
GRAMMAR_RESULT_CACHE_SIZE=64
GRAMMAR_RAG_CACHE_TTL_S=1800
GRAMMAR_RAG_CACHE_SIZE=128
# Cap slow Claude/Melong waits — then fall back to rules+RAG.
GRAMMAR_LLM_TIMEOUT_S=25
GRAMMAR_LLM_MAX_TOKENS=1800
GRAMMAR_RAG_MAX_PARTICLE_QUERIES=1

# App
APP_NAME=Monlam Rignor
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# LLM safety
LLM_MAX_TOKENS_CAP=4096
LLM_MAX_USER_CHARS=8000
LLM_MAX_MESSAGES=24

# Auth cookies are httpOnly (mr_access / mr_refresh). Frontend must call APIs with credentials.
