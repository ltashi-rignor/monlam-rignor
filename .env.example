# Monlam Melong — primary LLM for all agents (Studio X-API-Key)
MONLAM_API_KEY=YOUR_MONLAM_X_API_KEY
MONLAM_API_BASE=https://api-v1.monlamai.studio
MONLAM_MODEL=melong

# Database (local Homebrew PostgreSQL or Docker Compose)
DATABASE_URL=postgresql+asyncpg://lobsangtashi@localhost:5432/monlam_rignor
DATABASE_URL_SYNC=postgresql://lobsangtashi@localhost:5432/monlam_rignor

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Email OTP (Mailpit in Docker, or console fallback locally)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@monlam-rignor.local
OTP_EXPIRE_MINUTES=10
OTP_DEV_LOG=true

# Embeddings — BGE-M3 (Tibetan-capable), page-wise grammar handbook chunks
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# Knowledge
GRAMMAR_PDF_PATH=classical-tibetan-grammar-handbook_compress.pdf
CONTENT_PATH=data/content

# App
APP_NAME=Monlam Rignor
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
